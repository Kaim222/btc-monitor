//@version=6
// MSTX projected price. Put it on the MSTX chart (any intraday timeframe). Everything is in MSTX terms.
// Projected MSTX = yesterday's MSTX close x (1 + leverage x (projected MSTR / yesterday's MSTR close - 1)),
// where projected MSTR = BTC x (BTC held / ADSO) x target mNAV x (1 + average premium of the last 10 completed sessions)
// and target = fitted Bitcoin line with STRC shortfall below par and mNAV cap 2. The premium is computed here from daily closes.
// gap  = MSTX vs projected MSTX, percent: twice MSTR's excess over the premium (the swing signal; needs the holdings inputs).
// lag  = MSTR's bar low against its average over the trailing hour, at the lag's own slope, x leverage (the day-trade signal;
//        no holdings needed). Same rule as the monitor (mstr_gap.py): 30 bars after the open to arm, BTC's own 60-minute move
//        as the floor, buys only with BTC's last daily close above its 50-day, 60 minutes between lag alerts.
// Typed inputs are the values Pine cannot derive. The monitor rewrites their defaults from the live sources on every run.
indicator("MSTX Projection", shorttitle="MSTX Projection", overlay=true, max_lines_count=100, max_labels_count=100)

btcHeld   = input.float(848000, "BTC held", step=1, tooltip="api.strategy.com bitcoinKpis btcHoldings, read by the monitor every run (mstr_state.json btc_held).")
sharesM   = input.float(451.670, "Assumed diluted shares (M)", step=0.001, tooltip="api.strategy.com bitcoinKpis: BTC held / satsPerShare (mstr_state.json shares_m).")
slope     = input.float(0.025, "Target mNAV slope per $2,500 of BTC", step=0.0001, tooltip="Site data/mstr-config.json fit.b, fitted 2026-09-21.")
fitA      = input.float(0.9349260602738632, "Fitted intercept", step=0.0001, tooltip="Site data/mstr-config.json fit.a.")
fitC      = input.float(-0.0029161736798696616, "Fitted STRC shortfall", maxval=0, step=0.0001, tooltip="Site data/mstr-config.json fit.c, per point of STRC under par.")
fitPar    = input.float(100, "STRC par", step=1, tooltip="Site data/mstr-config.json fit.par.")
sheetBase = input.bool(true, "Sheet mNAV base from STRC", tooltip="On when the site's data/mstr-config.json fit is the sheet line: the base comes from STRC as in lagBase, plus the slope.")
lev       = input.float(2.0, "Fund leverage (MSTX = 2)", step=0.5)
lagSlope  = input.float(0.0125, "Lag slope per $2,500 of BTC (the lag runs on its own)", step=0.0025, tooltip="Site data/mstr-config.json lag_slope.")
lagT      = input.float(-3, "Lag alert, MSTX % vs the trailing window", step=0.5, tooltip="Site data/mstr-config.json lag_threshold x 200.")
cheapT    = input.float(-8.27558, "Cheap line, MSTX % under projection", step=0.5, tooltip="Site data/mstr-model.json premium.p25 x 200 (excess quartile, refreshed after each close).")
richT     = input.float(4.68898, "Rich line, MSTX % over projection", step=0.5, tooltip="Site data/mstr-model.json premium.p75 x 200 (excess quartile, refreshed after each close).")
btcHold   = input.float(-1, "BTC must have held (% over the window, floor)", step=0.1, tooltip="Site data/mstr-config.json btc_hour_move_floor x 100. Measured on BTC's own bars, 60 minutes back.")
winMins   = input.int(60, "Trailing window (minutes)", minval=5)
minMins   = input.int(30, "Minutes after the open before the lag can fire", minval=5, tooltip="The monitor's hour average needs 30 bars (rolling 60, min_periods 30), so its first lag is the 10:00 bar.")
coolMins  = input.int(60, "Minutes between lag alerts", minval=1, tooltip="The monitor's lag cooldown. A muted lag starts it too.")
tgtPct    = input.float(1.5, "Lag target, % above the signal bar", step=0.25)
showLines = input.bool(true, "Draw the lag target and stop lines")
useGate   = input.bool(true, "Trend gate: buys only with BTC above its 50-day", tooltip="Site data/mstr-config.json regime_gate.")
useGateSell = input.bool(false, "Gate the sell too (Rich only below the 50-day). Off: Rich fires either way", tooltip="Site data/mstr-config.json rich_gate.")
btcSym    = input.symbol("COINBASE:BTCUSD", "BTC symbol")
mstrSym   = input.symbol("BATS:MSTR", "MSTR symbol (the fund's underlying)")
strcSym   = input.symbol("BATS:STRC", "STRC symbol")
strcMan   = input.float(0, "STRC price override (0 = live)", step=0.01)

// the window is in minutes so it means the same on 1, 5 and 15 minute charts
winBars = math.max(2, math.round(winMins * 60 / timeframe.in_seconds()))
minBars = math.max(1, math.round(minMins * 60 / timeframe.in_seconds()))

btc      = request.security(btcSym, timeframe.period, close)
// BTC an hour ago on BTC's own bars, so before 10:30 the floor reaches into the overnight tape the way the monitor's does
btcAgo   = request.security(btcSym, timeframe.period, close[winBars])
// The gate is BTC's last COMPLETED daily close against the 50-day average of completed closes, which is what the monitor uses.
// [1] with lookahead on is the same completed day on history and in real time; with lookahead off history read a day late.
btcClose = request.security(btcSym, "D", close[1], lookahead=barmerge.lookahead_on)
btcMa50  = request.security(btcSym, "D", ta.sma(close, 50)[1], lookahead=barmerge.lookahead_on)
btcUp    = btcClose > btcMa50
mstrI    = request.security(mstrSym, timeframe.period, close)   // MSTR on this chart's bars
mstrLo   = request.security(mstrSym, timeframe.period, low)     // MSTR's low inside each bar
strcI    = request.security(strcSym, timeframe.period, close)   // STRC on this chart's bars
strc     = strcMan > 0 ? strcMan : strcI

// yesterday's closes, tracked from the intraday bars themselves (the daily-timeframe lookup lags on history and flips at 4 PM)
var float xLast = na
var float mLast = na
var float xPrev = na
var float mstrPrev = na
if session.isfirstbar_regular
    xPrev    := xLast
    mstrPrev := mLast
if session.ismarket
    xLast := close
    mLast := mstrI

lagBase(s) =>
    s >= 97.5 ? 0.90 :
      s >= 95 ? 0.875 + (s - 95) * 0.01 :
      s >= 92.5 ? 0.85 + (s - 92.5) * 0.01 :
      s >= 87.5 ? 0.825 + (s - 87.5) * 0.005 :
      s >= 82.5 ? 0.80 + (s - 82.5) * 0.005 :
      math.max(0.775, 0.775 + (s - 77.5) * 0.005)

// The outer daily request runs on MSTR sessions. Offset the complete average
// by one daily bar so today's changing price never enters its own baseline.
// BTC and STRC daily feeds and the supplied BPS inputs define this chart's line.
// Lookahead on pairs each session with BTC's close of the same UTC day (8 PM New York). With it off, BTC's daily bar
// closes after MSTR's, so every session read the previous day's BTC: 9/21 took Sunday's 81,160 instead of Monday's
// 86,595, and on 10/1 the 10-session average read -1.1% against the site's -3.1%. The [1] below keeps today out.
premiumN = input.int(10, "Premium sessions", minval=1, tooltip="Site data/mstr-config.json premium.n.")
priorPremium() =>
    db = request.security(btcSym, "D", close, lookahead=barmerge.lookahead_on)
    ds = request.security(strcSym, "D", close, lookahead=barmerge.lookahead_on)
    dt = (sheetBase ? math.min(2.0, lagBase(ds) + slope * (db - 75000) / 2500) : math.min(2.0, fitA + fitC * math.max(0, fitPar - ds) + slope * (db - 75000) / 2500))
    dp = close / (db * (btcHeld / (sharesM * 1e6)) * dt) - 1
    ta.sma(dp, premiumN)[1]
premiumAvg = request.security(mstrSym, "D", priorPremium(), lookahead=barmerge.lookahead_on)

target = (sheetBase ? math.min(2.0, lagBase(strc) + slope * (btc - 75000) / 2500) : math.min(2.0, fitA + fitC * math.max(0, fitPar - strc) + slope * (btc - 75000) / 2500))
bps    = btcHeld / (sharesM * 1e6)
lineM  = btc * bps * target
projM  = lineM * (1 + premiumAvg)                                       // projected MSTR (internal)
projX  = xPrev * (1 + lev * (projM / mstrPrev - 1))               // projected MSTX
gap    = 2 * (mstrI / lineM - 1 - premiumAvg) * 100                                // MSTX vs projected, percent

// lag: MSTR's move against BTC over the window (the backtested signal), shown in MSTX terms at the fund's leverage.
// In the first hour it averages the bars since the open.
tgtLag  = lagBase(strc) + lagSlope * (btc - 75000) / 2500       // the lag has its own slope; the projected line keeps slope
ratio   = mstrI / (btc * tgtLag)                                  // MSTR over what it should track; holdings cancel
var float sumR = 0.0
var int   cnt  = 0
if session.isfirstbar_regular
    sumR := 0.0
    cnt  := 0
avSince = cnt > 0 ? sumR / cnt : na
sumR := sumR + ratio
cnt  := cnt + 1
smaR  = ta.sma(ratio[1], winBars)
avR   = cnt - 1 >= winBars ? smaR : avSince
ratioLo = mstrLo / (btc * tgtLag)                                 // the worst point inside the bar
lag   = na(avR) ? na : lev * (ratioLo / avR - 1) * 100           // MSTR's lag at the bar's low, in MSTX terms (x leverage), so it reads the same on any timeframe
btcMove = (btc / btcAgo - 1) * 100
armed   = cnt - 1 >= minBars and session.ismarket

lagFire   = armed and not na(lag) and lag <= lagT and btcMove >= btcHold
cheapFire = gap <= cheapT and session.ismarket
richFire  = gap >= richT and session.ismarket
// one lag alert, then quiet for the cooldown, as the monitor does; a lag the gate mutes still starts the cooldown
var int lastLagT = na
lagNew    = lagFire and (na(lastLagT) or time - lastLagT >= coolMins * 60000)
if lagNew
    lastLagT := time
swingBuy  = cheapFire and not cheapFire[1] and (not useGate or btcUp)        // level: crossed under the cheap line, BTC trending up
swingSell = richFire and not richFire[1] and (not useGateSell or not btcUp)      // level: crossed over the rich line; ungated by default
lagBuy    = lagNew and (not useGate or btcUp)                                // speed: the day-trade lag (intraday charts only)

plot(close, "MSTX", color=color.new(color.orange, 0), linewidth=1)
plot(projX, "Projected MSTX", color=color.new(color.aqua, 0), linewidth=1)
plot(gap, "Gap (MSTX %)", color=color.new(color.orange, 0), display=display.none)    // hidden; shows in the legend
plot(lag, "Lag (MSTX %)", color=color.new(color.aqua, 0), display=display.none)      // hidden; shows in the legend, feeds the alert text as plot_3
plot(swingBuy ? close : na, "Swing buy", color=color.new(color.lime, 0), style=plot.style_cross, linewidth=4)     // green + on the line
plot(swingSell ? close : na, "Swing sell", color=color.new(color.red, 0), style=plot.style_cross, linewidth=4)    // red + on the line
plot(lagBuy ? close : na, "Lag (day trade)", color=color.new(color.orange, 0), style=plot.style_cross, linewidth=4)   // orange + on the line

// lag trade lines, drawn at the ENTRY bar (the first green bar after the orange plus):
// entry = that bar's high, target = entry + tgtPct%, stop = the lowest low from the signal bar to the entry bar. Lines run out the trade's window.
var bool  pending = false
var float dipLow  = na
var int   sigBar  = na
if lagBuy
    pending := true
    dipLow  := math.min(low, low[1])
    sigBar  := bar_index
if pending
    dipLow := math.min(dipLow, low)
    if close > close[1]
        entry = high
        tgt   = entry * (1 + tgtPct / 100)
        if showLines
            line.new(bar_index, entry, bar_index + winBars, entry, color=color.new(color.orange, 30), width=1, style=line.style_dotted)
            line.new(bar_index, tgt, bar_index + winBars, tgt, color=color.new(color.lime, 0), width=2)
            line.new(bar_index, dipLow, bar_index + winBars, dipLow, color=color.new(color.red, 0), width=2)
            label.new(bar_index + winBars, tgt, "target " + str.tostring(tgt, "#.##"), style=label.style_label_left, color=color.new(color.lime, 70), textcolor=color.white, size=size.small)
            label.new(bar_index + winBars, entry, "entry " + str.tostring(entry, "#.##"), style=label.style_label_left, color=color.new(color.orange, 70), textcolor=color.white, size=size.small)
            label.new(bar_index + winBars, dipLow, "stop " + str.tostring(dipLow, "#.##"), style=label.style_label_left, color=color.new(color.red, 70), textcolor=color.white, size=size.small)
        pending := false
    else if bar_index - sigBar > winBars or not session.ismarket
        pending := false                                   // no green bar inside the window: no trade

alertcondition(lagBuy, "Lag", "MSTX lag {{plot_3}}% vs its window with BTC holding. Window: the next hour.")
alertcondition(cheapFire and (not useGate or btcUp), "Cheap", "MSTX is under the cheap line vs projection. Swing signal.")
alertcondition(richFire and (not useGateSell or not btcUp), "Rich", "MSTX is over the rich line vs projection.")

var table tb = table.new(position.top_right, 2, 4, border_width=1, bgcolor=color.new(color.black, 0), frame_color=color.gray, border_color=color.new(color.gray, 60))
if barstate.islast
    W = color.white
    table.cell(tb, 0, 0, "MSTX", text_color=W, text_size=size.small)
    table.cell(tb, 1, 0, str.tostring(close, "#.##"), text_color=W, text_size=size.small)
    table.cell(tb, 0, 1, "projected", text_color=W, text_size=size.small)
    table.cell(tb, 1, 1, str.tostring(projX, "#.##"), text_color=color.aqua, text_size=size.small)
    table.cell(tb, 0, 2, "gap", text_color=W, text_size=size.small)
    table.cell(tb, 1, 2, str.tostring(gap, "#.##") + "%", text_color=gap <= cheapT ? color.lime : gap >= richT ? color.red : W, text_size=size.small)
    table.cell(tb, 0, 3, "lag", text_color=W, text_size=size.small)
    table.cell(tb, 1, 3, na(lag) ? "warming up" : str.tostring(lag, "#.##") + "%", text_color=not na(lag) and lag <= lagT ? color.aqua : W, text_size=size.small)
